# este archivo contiene variables de entorno para el proyecto. Debes crear un archivo .env en la raíz del proyecto y copiar estas variables allí, completando los valores según tu configuración.

# modo de ejecución del servidor (development o production)
NODE_ENV=development

# puerto en el que se ejecuta el servidor
PORT=5000

# url de mongodb (puedes usar una base de datos local o un servicio en la nube como MongoDB Atlas)
MONGO_URI=

# url de redis (puedes usar un servicio en la nube como Redis Labs o una instancia local)
REDIS_URL=

# secretos para la generación de tokens JWT (puedes poner cualquier texto para desarrollo)
JWT_SECRET=
JWT_REFRESH_SECRET=

# secretos para google oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# secretos para github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# secretos para cloudinary 
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# secretos para el envío de correos electrónicos (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=